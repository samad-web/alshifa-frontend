PORT=4000
FRONTEND_URL=http://localhost:8080
 
# Runtime queries — Supabase Transaction Mode pooler (port 6543).
# pgbouncer=true disables prepared statements (required by tx-mode pgbouncer).
# connection_limit=3 is the recommended cap for Prisma behind pgbouncer.
DATABASE_URL=postgresql://postgres.rptjzdephwcxufofyvts:Happykid04%40123@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3
 
# Migrations + introspection — direct/session connection (port 5432).
# `prisma migrate` uses this so it can hold a transaction across the whole run.
DIRECT_URL=postgresql://postgres.rptjzdephwcxufofyvts:Happykid04%40123@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
 
# Override defaults in lib/prisma.js to match the tx-mode cap above.
DB_POOL_SIZE=3
DB_POOL_TIMEOUT=20
 
JWT_SECRET=supersecret_iwis_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret
 
# Local Redis (portable binary at ~/redis/redis-server.exe)
REDIS_URL=redis://localhost:6379
 
# Evolution API (WhatsApp gateway)
EVOLUTION_API_URL=https://message.sirahagents.com
EVOLUTION_API_KEY=B4C74864809C-484C-AD8B-71206BB5BE4B
EVOLUTION_INSTANCE=sirahdigital
WHATSAPP_DEFAULT_CONSULTATION_MINUTES=30
 
# Supabase Storage — required for image/file uploads (clinical photos,
# profile pictures, prescriptions, triage documents). Without these vars the
# upload middleware falls back to local disk, which the backend does NOT serve
# statically — uploaded images render as broken icons in the UI.
# Get the service-role key from: Supabase dashboard → Project Settings → API.
SUPABASE_URL=https://rptjzdephwcxufofyvts.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
 
# Google Maps server-side key for the Home Therapy geocoding service.
# REPLACE the placeholder with a real key from Google Cloud Console.
# Required APIs: Geocoding API. (Directions / Distance Matrix / Maps JS are
# only used by the frontend key, not this one.)
# When unset OR placeholder, the geocoder no-ops and patient addresses save
# with locationVerified = false. Admins can press "Re-verify Location" on
# the patient profile after the real key is added here.
GOOGLE_MAPS_SERVER_KEY=AIzaSyDgPVjnv57imdkB6r45Z2jkmSYJZCZz-as
 
# ── Ayurvedic Voice Health Coach ─────────────────────────────────────────────
# OpenAI: used for both Whisper STT and gpt-4o-mini chat completions.
# Get one at https://platform.openai.com/api-keys
# Requires ≥ $5 credit at https://platform.openai.com/settings/organization/billing
# (the free tier does NOT include API access).
OPENAI_API_KEY=your_openai_api_key_here
 
# Google Cloud Text-to-Speech: used to synthesize spoken coach replies.
# Enable the API: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
# Then create credentials → API key, restricted to "Cloud Text-to-Speech API" only.
# First 4M chars/month of WaveNet voices are free.
# Optional — if unset, voice input still works but replies come back as text only.
GCP_TTS_API_KEY=RAIzaSyB6Hy8Pqp6hMEmiIWXn7tiRTCAIH_t060M
 
DAILY_API_KEY=f18f47a0380a487e63a00f9a0ad3edba94537db25d8f3deb909f4a7207c849c3
DAILY_API_URL=https://api.daily.co/v1
DAILY_DOMAIN=iwis.daily.co
DAILY_WEBHOOK_SECRET=
 