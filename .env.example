# ─── Al-Shifa Frontend — Environment Configuration ───────────────────────────
# All VITE_* vars are embedded into the bundle at BUILD time, not runtime.
# Rebuild the image / re-run `vite build` whenever a value changes.

# ── API ──────────────────────────────────────────────────────────────────────
# Required in production. The dev server proxies /api → localhost:4000 via
# vite.config.ts, so you can leave this unset locally.
VITE_API_BASE_URL="http://localhost:4000"

# Optional — defaults to VITE_API_BASE_URL in the app. Override only when the
# websocket endpoint lives on a different host (e.g. dedicated Socket.IO pool).
# VITE_SOCKET_URL="wss://api.alshifa.health"

# ── Supabase (file uploads: clinical photos, journey media) ─────────────────
# Anon/public key only — NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Sentry (optional) ────────────────────────────────────────────────────────
# Frontend DSN (public). Leave blank to disable client-side error reporting.
VITE_SENTRY_DSN=
